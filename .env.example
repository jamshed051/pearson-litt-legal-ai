# Legal Draft Assistant MVP — Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose "openrouter" (recommended), "anthropic", or "openai"
LLM_PROVIDER=openrouter

# OpenRouter (recommended — free models available, no credit card required)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free model options:
#   mistralai/mistral-7b-instruct:free
#   meta-llama/llama-3-8b-instruct:free
#   google/gemma-2-9b-it:free
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Anthropic (Claude) — alternative
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (GPT) — alternative
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Embedding Model ───────────────────────────────────────────────────────────
# Uses sentence-transformers (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_CHUNKS=5
MIN_CONFIDENCE_THRESHOLD=0.3
